{
    "name": "fluffydiscord/rapira-integration-app",
    "description": "Minimal Symfony app that exercises the Rapira bundle end to end",
    "type": "project",
    "require": {
        "php": ">=8.4",
        "symfony/framework-bundle": "^7.4 || ^8",
        "symfony/runtime": "^7.4 || ^8",
        "symfony/console": "^7.4 || ^8",
        "symfony/dotenv": "^7.4 || ^8",
        "fluffydiscord/rapira-symfony-bundle": "@dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "/bundle",
            "options": {
                "symlink": false
            }
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true,
            "symfony/flex": false
        }
    }
}
