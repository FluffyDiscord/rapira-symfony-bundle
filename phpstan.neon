parameters:
    level: max
    paths:
        - src
    stubFiles:
        - phpstan/xhprof.stub
        # Delete with the stub once rapira/contract ^0.9.2 is required.
        - phpstan/rapira.stub
    scanFiles:
        - vendor/rapira/contract/src/functions.php
    ignoreErrors:
        # RapiraMicroKernelTrait is consumed by the application's Kernel, not within the bundle.
        - identifier: trait.unused
